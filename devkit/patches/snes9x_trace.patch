+    if (!tr_db[pc]) tr_db[pc] = 0x100 | db; else if ((tr_db[pc] & 0xFF) != db) tr_db[pc] |= 0x200;
+    if (!tr_dp[pc]) tr_dp[pc] = 0x10000 | d; else if ((tr_dp[pc] & 0xFFFF) != d) tr_dp[pc] |= 0x20000;
