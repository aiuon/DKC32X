+      for (int i = 0; i < (1 << 22); i++) old[i] |= tr_romr[i] | (tr_dmar[i] << 1);
+      f = fopen(p, "wb"); fwrite(old, 1, 1 << 22, f); fclose(f); free(old); }
+    { snprintf(p, sizeof p, "%s/wram.bin", dir); uint8_t *old = (uint8_t *)calloc(1 << 17, 1); f = fopen(p, "rb"); if (f) { fread(old, 1, 1 << 17, f); fclose(f); }
