+extern uint32_t tr_frame;
+uint32_t tr_frame;
+uint32_t tr_redirect;
+/* TRJUMP=frame:key - at the first NMI handler entry (00:A968) from that frame on, run from key instead
+   (key = mode bits << 20 | pc, as the 32X runtime's game_debug_jump): reach the ending etc. in a capture */
+static void tr_jump_check(uint32_t pc) {
+    static int init, done; static uint32_t jf, jk;
+    if (!init) { init = 1; const char *q = getenv("TRJUMP"); if (q) { jf = strtoul(q, 0, 10); const char *c = strchr(q, ':'); jk = c ? strtoul(c + 1, 0, 16) : 0; } else done = 1; }
+    if (!done && pc == 0x00A968 && tr_frame >= jf && jk) { done = 1; tr_redirect = jk | 0x80000000u; }
