+      f = fopen(p, "wb"); fwrite(old, 1, 1 << 17, f); fclose(f); free(old); }
+    snprintf(p, sizeof p, "%s/io.txt", dir); f = fopen(p, "a");
+    for (int i = 0; i < HS; i++) if (ios[i]) { uint64_t k = ios[i] - 1; fprintf(f, "%06x %c %06x\n", (unsigned)(k >> 32), (k >> 24) & 1 ? 'w' : 'r', (unsigned)(k & 0xFFFFFF)); }
+    fclose(f);
+}
