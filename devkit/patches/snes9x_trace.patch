+#include "tracehook.h"
+#include <stdlib.h>
+#include <string.h>
+#include "snes9x.h"
+#include "memmap.h"
+int tr_on;
+uint32_t *tr_cov, *tr_wr, *tr_ww, *tr_wlast, *tr_rfirst;
+uint32_t tr_curpc;
+uint64_t tr_icount;
+FILE *tr_file;
+/* per-PC state summary */
+static uint8_t *tr_pst;      /* bit (M<<1|X) seen, bit4 = E seen */
+static uint16_t *tr_db;      /* 0x100 | db, 0x200 = multiple */
+static uint32_t *tr_dp;      /* 0x10000 | d, 0x20000 = multiple */
+/* hash sets */
+#define HS (1 << 20)
+static uint64_t *edges, *ios, *dmas;
+uint8_t *tr_romr; static uint8_t *tr_dmar;
+static uint32_t prevpc; static uint8_t prevop;
+static void hs_add(uint64_t *t, uint64_t k) {
+    k += 1; uint64_t h = (k * 0x9E3779B97F4A7C15ull) >> 44;
+    for (;;) { h &= HS - 1; if (t[h] == k) return; if (!t[h]) { t[h] = k; return; } h++; }
+}
+void tr_init(void) {
+    if (!tr_cov) {
+        tr_cov = (uint32_t *)calloc(1 << 24, 4);
+        tr_wr = (uint32_t *)calloc(1 << 17, 4); tr_ww = (uint32_t *)calloc(1 << 17, 4);
+        tr_wlast = (uint32_t *)calloc(1 << 17, 4); tr_rfirst = (uint32_t *)calloc(1 << 17, 4);
+        tr_pst = (uint8_t *)calloc(1 << 24, 1); tr_db = (uint16_t *)calloc(1 << 24, 2); tr_dp = (uint32_t *)calloc(1 << 24, 4);
