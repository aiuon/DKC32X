+#ifndef TRACEHOOK_H
+#define TRACEHOOK_H
+#include <stdint.h>
+#include <stdio.h>
+extern int tr_on;
+extern uint32_t *tr_cov, *tr_wr, *tr_ww, *tr_wlast, *tr_rfirst;
+extern uint32_t tr_curpc;
+extern uint64_t tr_icount;
+extern FILE *tr_file;
+void tr_io(uint32_t a, int w);
+extern uint8_t *tr_romr;
+void tr_dma(uint32_t src, uint32_t n, uint32_t b, int rev);
+static inline void tr_access(uint32_t a, int w) {
+    if (!tr_on) return;
+    uint32_t bank = (a >> 16) & 0xFF, off = a & 0xFFFF, wa;
+    if (bank == 0x7E || bank == 0x7F) wa = ((bank & 1) << 16) | off;
+    else if ((bank & 0x40) == 0 && off < 0x2000) wa = off;
+    else {
+        if ((bank & 0x40) == 0 && off < 0x8000) tr_io(a, w);
+        else if (!w && tr_romr) tr_romr[(((bank & 0x3F) << 16) | off)] = 1;
+        return;
+    }
+    if (w) { tr_ww[wa]++; tr_wlast[wa] = tr_curpc; }
+    else { if (!tr_wr[wa]) tr_rfirst[wa] = tr_curpc; tr_wr[wa]++; }
+}
+void tr_insn(uint32_t pc, uint8_t op, uint8_t p, uint8_t e, uint8_t db, uint16_t d);
+extern uint32_t tr_redirect;
+#endif
