+    fclose(f);
+    snprintf(p, sizeof p, "%s/dma.txt", dir); f = fopen(p, "a");
+    for (int i = 0; i < HS; i++) if (dmas[i]) { uint64_t k = dmas[i] - 1; fprintf(f, "%06x %02x %d %06x\n", (unsigned)(k >> 40), (unsigned)((k >> 32) & 0xFF), (int)((k >> 31) & 1), (unsigned)(k & 0xFFFFFF)); }
