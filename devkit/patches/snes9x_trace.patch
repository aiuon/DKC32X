+    case 0x6C: case 0x7C: case 0xDC: case 0xFC: case 0x60: case 0x6B: case 0x40: case 0x22: case 0x20: case 0x5C: case 0x4C: case 0x00:
+        hs_add(edges, ((uint64_t)prevpc << 32) | pc); break;
+    }
+    prevpc = pc; prevop = op;
+}
+/* write summaries: state.txt (pc pst db dp count), edges.txt, io.txt; accumulate across runs by appending */
+void tr_dma(uint32_t src, uint32_t n, uint32_t b, int rev) {
+    if (!tr_on) return;
+    hs_add(dmas, ((uint64_t)tr_curpc << 40) | ((uint64_t)(b & 0xFF) << 32) | ((uint64_t)rev << 31) | (src & 0xFFFFFF));
